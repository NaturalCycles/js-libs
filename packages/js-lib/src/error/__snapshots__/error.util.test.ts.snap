    "message": "yada",
  } => "{ "message": "yada" }",
  {
    "data": {},
    "message": "yada",
  } => "{ "message": "yada", "data": {} }",
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
  } => "{ "message": "yada", "data": { "backendResponseStatusCode...",
  {
    "message": "yada",
    "name": "Error",
