exports[`should match the snapshot for _anyToErrorObject on sample values 1`] = `
Map {
  undefined => {
    "data": {},
    "message": "undefined",
    "name": "Error",
  },
  null => {
    "data": {},
    "message": "null",
    "name": "Error",
  },
  "" => {
    "data": {},
    "message": "empty_string",
    "name": "Error",
  },
  "hello a" => {
    "data": {},
    "message": "hello a",
    "name": "Error",
  },
  0 => {
    "data": {},
    "message": "0",
    "name": "Error",
  },
  1 => {
    "data": {},
    "message": "1",
    "name": "Error",
  },
  -5 => {
    "data": {},
    "message": "-5",
    "name": "Error",
  },
  [Function] => {
    "data": {},
    "message": "function",
    "name": "Error",
  },
  {} => {
    "data": {},
    "message": "{}",
    "name": "Error",
  },
  [] => {
    "data": {},
    "message": "[]",
    "name": "Error",
  },
  [
    "a",
  ] => {
    "data": {},
    "message": "[
  "a"
]",
    "name": "Error",
  },
  {
    "a": "aa",
  } => {
    "data": {},
    "message": "{
  "a": "aa"
}",
    "name": "Error",
  },
  [Error: err msg] => {
    "data": {},
    "message": "err msg",
    "name": "Error",
  },
  {
    "message": "yada",
  } => {
    "data": {},
    "message": "{
  "message": "yada"
}",
    "name": "Error",
  },
  {
    "data": {},
    "message": "yada",
  } => {
    "data": {},
    "message": "{
  "message": "yada",
  "data": {}
}",
    "name": "Error",
  },
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
  } => {
    "data": {},
    "message": "{
  "message": "yada",
  "data": {
    "backendResponseStatusCode": 404
  }
}",
    "name": "Error",
  },
  {
    "message": "yada",
    "name": "Error",
  } => {
    "data": {},
    "message": "yada",
    "name": "Error",
  },
  {
    "data": {},
    "message": "yada",
    "name": "Error",
  } => {
    "data": {},
    "message": "yada",
    "name": "Error",
  },
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
    "name": "Error",
  } => {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
    "name": "Error",
  },
  [AppError: err msg] => {
    "data": {},
    "message": "err msg",
    "name": "AppError",
  },
  [HttpRequestError: http err msg] => {
    "cause": {
      "data": {},
      "message": "Type error: la-la",
      "name": "AppError",
    },
    "data": {
      "backendResponseStatusCode": 400,
    },
    "message": "http err msg",
    "name": "HttpRequestError",
  },
  {
    "error": {
      "data": {
        "a": "b
c",
        "backendResponseStatusCode": 400,
      },
      "message": "err msg",
      "name": "HttpError",
    },
  } => {
    "data": {
      "a": "b
c",
      "backendResponseStatusCode": 400,
    },
    "message": "err msg",
    "name": "HttpError",
  },
}
`;

