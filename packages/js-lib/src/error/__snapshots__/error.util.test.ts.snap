// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`should convert an AppError to an ErrorObject with its name, message, data and stack 1`] = `
{
  "data": {
    "a": "b",
  },
  "message": "hello",
  "name": "AppError",
  "stack": StringContaining "AppError",
}
`;

exports[`should convert any value to an Error, keeping Errors as-is and the stack when repacking 1`] = `
Map {
  undefined => [Error: undefined],
  null => [Error: null],
  "" => [Error: empty_string],
  "hello a" => [Error: hello a],
  0 => [Error: 0],
  1 => [Error: 1],
  -5 => [Error: -5],
  [Function] => [Error: function],
  {} => [Error: {}],
  [] => [Error: []],
  [
    "a",
  ] => [Error: [
  "a"
]],
  {
    "a": "aa",
  } => [Error: {
  "a": "aa"
}],
  [Error: err msg] => [Error: err msg],
  {
    "message": "yada",
  } => [Error: {
  "message": "yada"
}],
  {
    "data": {},
    "message": "yada",
  } => [Error: {
  "message": "yada",
  "data": {}
}],
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
  } => [Error: {
  "message": "yada",
  "data": {
    "backendResponseStatusCode": 404
  }
}],
  {
    "message": "yada",
    "name": "Error",
  } => [Error: yada],
  {
    "data": {},
    "message": "yada",
    "name": "Error",
  } => [Error: yada],
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
    "name": "Error",
  } => [Error: yada],
  [AppError: err msg] => [AppError: err msg],
  [HttpRequestError: http err msg] => [HttpRequestError: http err msg],
  {
    "error": {
      "data": {
        "a": "b
c",
        "backendResponseStatusCode": 400,
      },
      "message": "err msg",
      "name": "HttpError",
    },
  } => [HttpError: err msg],
}
`;

exports[`should detect Errors and objects with a string name and message as error-like 1`] = `
Map {
  undefined => false,
  null => false,
  "" => false,
  "hello a" => false,
  0 => false,
  1 => false,
  -5 => false,
  [Function] => false,
  {} => false,
  [] => false,
  [
    "a",
  ] => false,
  {
    "a": "aa",
  } => false,
  [Error: err msg] => true,
  {
    "message": "yada",
  } => false,
  {
    "data": {},
    "message": "yada",
  } => false,
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
  } => false,
  {
    "message": "yada",
    "name": "Error",
  } => true,
  {
    "data": {},
    "message": "yada",
    "name": "Error",
  } => true,
  {
    "data": {
      "backendResponseStatusCode": 404,
    },
    "message": "yada",
    "name": "Error",
  } => true,
  [AppError: err msg] => true,
  [HttpRequestError: http err msg] => true,
  {
    "error": {
      "data": {
        "a": "b
c",
        "backendResponseStatusCode": 400,
      },
      "message": "err msg",
      "name": "HttpError",
    },
  } => false,
}
`;

