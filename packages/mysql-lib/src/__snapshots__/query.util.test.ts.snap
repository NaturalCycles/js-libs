exports[`should build DELETE with and without a filter 1`] = `"DELETE FROM \`TBL1\`"`;

exports[`should build DELETE with and without a filter 2`] = `"DELETE FROM \`TBL1\` WHERE \`a\` IS NOT NULL"`;

exports[`should build SELECT with filters, NULL checks, IN lists, order and limit 1`] = `"SELECT * FROM \`TBL1\`"`;

exports[`should build SELECT with filters, NULL checks, IN lists, order and limit 2`] = `"SELECT * FROM \`TBL1\` WHERE \`a\` = 'b' AND \`c\` > '2019' ORDER BY \`aaa\` ASC, \`bbb\` DESC LIMIT 15"`;

exports[`should build SELECT with filters, NULL checks, IN lists, order and limit 3`] = `"SELECT * FROM \`TBL1\` WHERE \`num\` > 15"`;

exports[`should build SELECT with filters, NULL checks, IN lists, order and limit 4`] = `"SELECT * FROM \`TBL1\` WHERE \`a\` IS NULL AND \`a2\` IS NULL AND \`a3\` IS NOT NULL"`;

exports[`should build SELECT with filters, NULL checks, IN lists, order and limit 5`] = `"SELECT * FROM \`TBL1\` WHERE \`a\` IN ('a1', 'a2', 'a3')"`;

exports[`should build UPDATE with and without a filter 1`] = `"UPDATE \`TEST_TABLE\` SET \`id\` = 'id1', \`k1\` = 'v1', \`k2\` = 'v2', \`k3\` = 1, \`even\` = false, \`nested\` = '{\\"foo\\":1}', \`created\` = 1529539200, \`updated\` = 1529539200"`;

exports[`should build UPDATE with and without a filter 2`] = `"UPDATE \`TEST_TABLE\` SET \`id\` = 'id1', \`k1\` = 'v1', \`k2\` = 'v2', \`k3\` = 1, \`even\` = false, \`nested\` = '{\\"foo\\":1}', \`created\` = 1529539200, \`updated\` = 1529539200 WHERE \`a\` > 5"`;

exports[`should build one INSERT statement for a few rows 1`] = `
