{
  "plugins": ["unicorn", "typescript", "oxc", "import", "jsdoc", "vitest", "promise", "node"],
  "jsPlugins": ["cfg/oxlint-plugin-nc.js", "cfg/oxlint-plugin-stylistic.js"],
  "categories": {
    "correctness": "deny"
  },
  "rules": {
    "@stylistic/lines-between-class-members": [
      "deny",
      "always",
      {
        "exceptAfterSingleLine": true
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "deny",
      {
        "blankLine": "always",
        "prev": "function",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "function"
      },
      {
        "blankLine": "always",
        "prev": "class",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "class"
      }
    ],
    "complexity": [
      "deny",
      {
        "max": 40
      }
    ],
    "constructor-super": "deny",
    "curly": ["deny", "multi-line"],
    "eqeqeq": [
      "deny",
      "always",
      {
        "null": "ignore"
      }
    ],
    "for-direction": "deny",
    "getter-return": "deny",
    "guard-for-in": "deny",
    "id-denylist": ["deny", "opts"],
    "id-match": [
      "deny",
      "^.+$",
      {
        "classFields": false,
        "ignoreDestructuring": false,
        "onlyDeclarations": false,
        "properties": false
      }
    ],
    "logical-assignment-operators": [
      "deny",
      "always",
      {
        "enforceForIfStatements": true
      }
    ],
    "max-params": [
      "deny",
      {
        "max": 5
      }
    ],
    "no-array-constructor": "deny",
    "no-async-promise-executor": "allow",
    "no-bitwise": "deny",
    "no-caller": "deny",
    "no-class-assign": "deny",
    "no-compare-neg-zero": "deny",
    "no-cond-assign": "deny",
    "no-const-assign": "deny",
    "no-constant-binary-expression": "deny",
    "no-constant-condition": "deny",
    "no-control-regex": "deny",
    "no-debugger": "deny",
    "no-delete-var": "deny",
    "no-dupe-class-members": "deny",
    "no-dupe-else-if": "deny",
    "no-dupe-keys": "deny",
    "no-duplicate-case": "deny",
    "no-duplicate-imports": [
      "allow",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "no-empty": [
      "deny",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-empty-character-class": "deny",
    "no-empty-pattern": "deny",
    "no-empty-static-block": "deny",
    "no-eval": "deny",
    "no-ex-assign": "deny",
    "no-extend-native": "deny",
    "no-extra-bind": "deny",
    "no-extra-boolean-cast": "deny",
    "no-func-assign": "deny",
    "no-global-assign": "deny",
    "no-implicit-coercion": [
      "deny",
      {
        "allow": ["!!"]
      }
    ],
    "no-implied-eval": "deny",
    "no-import-assign": "deny",
    "no-invalid-regexp": "deny",
    "no-irregular-whitespace": "deny",
    "no-iterator": "deny",
    "no-loss-of-precision": "deny",
    "no-misleading-character-class": "deny",
    "no-nested-ternary": "deny",
    "no-new": "deny",
    "no-new-native-nonconstructor": "deny",
    "no-new-wrappers": "deny",
    "no-nonoctal-decimal-escape": "deny",
    "no-obj-calls": "deny",
    "no-prototype-builtins": "deny",
    "no-regex-spaces": "deny",
    "no-restricted-globals": [
      "deny",
      "event",
      "__dirname",
      "__filename",
      {
        "name": "Intl",
        "message": "Use Intl2 instead."
      },
      {
        "name": "Date",
        "message": "Use localTime / localDate from @naturalcycles/js-lib/datetime."
      }
    ],
    "no-self-assign": "deny",
    "no-sequences": "deny",
    "no-setter-return": "deny",
    "no-shadow": "allow",
    "no-shadow-restricted-names": "deny",
    "no-sparse-arrays": "deny",
    "no-this-before-super": "deny",
    "no-unassigned-vars": "deny",
    "no-unexpected-multiline": "deny",
    "no-unneeded-ternary": "deny",
    "no-unreachable": "deny",
    "no-unsafe-finally": "deny",
    "no-unsafe-negation": "deny",
    "no-unsafe-optional-chaining": "deny",
    "no-unused-expressions": "deny",
    "no-unused-labels": "deny",
    "no-unused-private-class-members": "deny",
    "no-unused-vars": [
      "deny",
      {
        "fix": {
          "imports": "safe-fix",
          "variables": "suggestion"
        },
        "varsIgnorePattern": "^(_$|__)",
        "argsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "no-useless-assignment": "allow",
    "no-useless-backreference": "deny",
    "no-useless-call": "deny",
    "no-useless-catch": "deny",
    "no-useless-concat": "deny",
    "no-useless-constructor": "deny",
    "no-useless-escape": "deny",
    "no-useless-rename": "deny",
    "no-useless-return": "allow",
    "no-var": "deny",
    "no-with": "deny",
    "object-shorthand": "deny",
    "prefer-const": [
      "deny",
      {
        "destructuring": "all"
      }
    ],
    "prefer-object-has-own": "deny",
    "prefer-spread": "deny",
    "preserve-caught-error": "deny",
    "require-yield": "deny",
    "unicode-bom": "deny",
    "use-isnan": "deny",
    "valid-typeof": "deny",
    "import/consistent-type-specifier-style": "deny",
    "import/default": "deny",
    "import/extensions": [
      "deny",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "import/namespace": "deny",
    "import/newline-after-import": "deny",
    "import/no-absolute-path": "deny",
    "import/no-amd": "deny",
    "import/no-commonjs": "deny",
    "import/no-cycle": "deny",
    "import/no-default-export": "deny",
    "import/no-duplicates": [
      "deny",
      {
        "prefer-inline": false
      }
    ],
    "import/no-empty-named-blocks": "deny",
    "import/no-named-as-default": "deny",
    "import/no-named-as-default-member": "allow",
    "import/no-named-default": "deny",
    "import/no-self-import": "deny",
    "import/no-unassigned-import": "allow",
    "import/no-webpack-loader-syntax": "deny",
    "jsdoc/check-property-names": "deny",
    "jsdoc/check-tag-names": "deny",
    "jsdoc/implements-on-classes": "deny",
    "jsdoc/no-defaults": "deny",
    "jsdoc/require-property": "deny",
    "jsdoc/require-property-description": "deny",
    "jsdoc/require-property-name": "deny",
    "jsdoc/require-property-type": "deny",
    "jsdoc/require-yields": "allow",
    "nc/prefer-assert": "deny",
    "nc/prefer-env-destructuring": "deny",
    "nc/prefer-last": "deny",
    "oxc/approx-constant": "deny",
    "oxc/bad-array-method-on-arguments": "deny",
    "oxc/bad-bitwise-operator": "deny",
    "oxc/bad-char-at-comparison": "deny",
    "oxc/bad-comparison-sequence": "deny",
    "oxc/bad-match-all-arg": "deny",
    "oxc/bad-min-max-func": "deny",
    "oxc/bad-object-literal-comparison": "deny",
    "oxc/bad-replace-all-arg": "deny",
    "oxc/branches-sharing-code": "allow",
    "oxc/const-comparisons": "deny",
    "oxc/double-comparisons": "deny",
    "oxc/erasing-op": "deny",
    "oxc/misrefactored-assign-op": "deny",
    "oxc/missing-throw": "deny",
    "oxc/no-accumulating-spread": "deny",
    "oxc/no-const-enum": "deny",
    "oxc/no-map-spread": "allow",
    "oxc/number-arg-out-of-range": "deny",
    "oxc/only-used-in-recursion": "deny",
    "oxc/uninvoked-array-callback": "deny",
    "promise/no-callback-in-promise": "deny",
    "promise/no-new-statics": "deny",
    "promise/spec-only": "deny",
    "promise/valid-params": "deny",
    "typescript/adjacent-overload-signatures": "deny",
    "typescript/array-type": "deny",
    "typescript/await-thenable": "deny",
    "typescript/ban-ts-comment": [
      "deny",
      {
        "minimumDescriptionLength": 2,
        "ts-expect-error": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "ts-check": false,
        "ts-ignore": true
      }
    ],
    "typescript/ban-tslint-comment": "deny",
    "typescript/class-literal-property-style": "deny",
    "typescript/consistent-generic-constructors": ["deny", "constructor"],
    "typescript/consistent-type-assertions": [
      "deny",
      {
        "assertionStyle": "as"
      }
    ],
    "typescript/consistent-type-definitions": ["deny", "interface"],
    "typescript/consistent-type-exports": "deny",
    "typescript/consistent-type-imports": "deny",
    "typescript/dot-notation": "allow",
    "typescript/explicit-function-return-type": [
      "deny",
      {
        "allowExpressions": true
      }
    ],
    "typescript/explicit-member-accessibility": [
      "deny",
      {
        "accessibility": "no-public",
        "overrides": {
          "parameterProperties": "off"
        }
      }
    ],
    "typescript/method-signature-style": "deny",
    "typescript/no-array-delete": "deny",
    "typescript/no-base-to-string": "deny",
    "typescript/no-confusing-non-null-assertion": "deny",
    "typescript/no-duplicate-enum-values": "deny",
    "typescript/no-duplicate-type-constituents": "deny",
    "typescript/no-empty-object-type": [
      "deny",
      {
        "allowInterfaces": "always"
      }
    ],
    "typescript/no-extra-non-null-assertion": "deny",
    "typescript/no-floating-promises": "deny",
    "typescript/no-for-in-array": "deny",
    "typescript/no-implied-eval": "deny",
    "typescript/no-import-type-side-effects": "deny",
    "typescript/no-inferrable-types": [
      "deny",
      {
        "ignoreParameters": true
      }
    ],
    "typescript/no-meaningless-void-operator": "deny",
    "typescript/no-misused-new": "deny",
    "typescript/no-misused-promises": [
      "deny",
      {
        "checksVoidReturn": {
          "arguments": false,
          "properties": false
        }
      }
    ],
    "typescript/no-misused-spread": "deny",
    "typescript/no-mixed-enums": "deny",
    "typescript/no-non-null-asserted-nullish-coalescing": "deny",
    "typescript/no-non-null-asserted-optional-chain": "deny",
    "typescript/no-redundant-type-constituents": "allow",
    "typescript/no-require-imports": "deny",
    "typescript/no-restricted-types": [
      "deny",
      {
        "types": {
          "Boolean": {
            "message": "Avoid using the `Boolean` type. Did you mean `boolean`?"
          },
          "Number": {
            "message": "Avoid using the `Number` type. Did you mean `number`?"
          },
          "object": {
            "message": "The `object` type is currently hard to use ([see this issue](https://github.com/microsoft/TypeScript/issues/21732)).\nConsider using `Record<string, any>` instead, as it allows you to more easily inspect and use the keys."
          },
          "Object": {
            "message": "Avoid using the `Object` type. Did you mean `object`? Consider using Record<string, any> instead"
          },
          "String": {
            "message": "Avoid using the `String` type. Did you mean `string`?"
          },
          "Symbol": {
            "message": "Avoid using the `Symbol` type. Did you mean `symbol`?"
          }
        }
      }
    ],
    "typescript/no-this-alias": "allow",
    "typescript/no-unnecessary-boolean-literal-compare": "deny",
    "typescript/no-unnecessary-parameter-property-assignment": "deny",
    "typescript/no-unnecessary-qualifier": "deny",
    "typescript/no-unnecessary-template-expression": "deny",
    "typescript/no-unnecessary-type-arguments": "allow",
    "typescript/no-unnecessary-type-assertion": "deny",
    "typescript/no-unnecessary-type-constraint": "deny",
    "typescript/no-unnecessary-type-conversion": "deny",
    "typescript/no-unnecessary-type-parameters": "allow",
    "typescript/no-unsafe-declaration-merging": "deny",
    "typescript/no-unsafe-function-type": "deny",
    "typescript/no-unsafe-unary-minus": "deny",
    "typescript/no-useless-default-assignment": "deny",
    "typescript/no-useless-empty-export": "deny",
    "typescript/no-var-requires": "deny",
    "typescript/no-wrapper-object-types": "deny",
    "typescript/non-nullable-type-assertion-style": "deny",
    "typescript/only-throw-error": "deny",
    "typescript/prefer-as-const": "deny",
    "typescript/prefer-enum-initializers": "deny",
    "typescript/prefer-find": "deny",
    "typescript/prefer-for-of": "deny",
    "typescript/prefer-function-type": "deny",
    "typescript/prefer-literal-enum-member": "deny",
    "typescript/prefer-namespace-keyword": "deny",
    "typescript/prefer-optional-chain": "deny",
    "typescript/prefer-promise-reject-errors": "deny",
    "typescript/prefer-reduce-type-parameter": "deny",
    "typescript/prefer-string-starts-ends-with": [
      "deny",
      {
        "allowSingleElementEquality": "always"
      }
    ],
    "typescript/prefer-ts-expect-error": "deny",
    "typescript/promise-function-async": [
      "deny",
      {
        "checkArrowFunctions": false,
        "checkFunctionDeclarations": true,
        "checkFunctionExpressions": true,
        "checkMethodDeclarations": true
      }
    ],
    "typescript/require-array-sort-compare": "allow",
    "typescript/require-await": "allow",
    "typescript/restrict-plus-operands": "deny",
    "typescript/restrict-template-expressions": "allow",
    "typescript/return-await": ["deny", "error-handling-correctness-only"],
    "typescript/switch-exhaustiveness-check": "allow",
    "typescript/triple-slash-reference": "deny",
    "typescript/unbound-method": [
      "allow",
      {
        "ignoreStatic": true
      }
    ],
    "unicorn/catch-error-name": [
      "deny",
      {
        "name": "err",
        "ignore": ["^err\\d*$", "^_"]
      }
    ],
    "unicorn/consistent-assert": "deny",
    "unicorn/consistent-date-clone": "deny",
    "unicorn/consistent-empty-array-spread": "deny",
    "unicorn/consistent-existence-index-check": "deny",
    "unicorn/error-message": "deny",
    "unicorn/escape-case": "deny",
    "unicorn/no-accessor-recursion": "deny",
    "unicorn/no-anonymous-default-export": "deny",
    "unicorn/no-array-reduce": "deny",
    "unicorn/no-await-in-promise-methods": "deny",
    "unicorn/no-console-spaces": "deny",
    "unicorn/no-document-cookie": "deny",
    "unicorn/no-empty-file": "deny",
    "unicorn/no-hex-escape": "deny",
    "unicorn/no-immediate-mutation": "deny",
    "unicorn/no-instanceof-builtins": "deny",
    "unicorn/no-invalid-fetch-options": "deny",
    "unicorn/no-invalid-remove-event-listener": "deny",
    "unicorn/no-length-as-slice-end": "deny",
    "unicorn/no-lonely-if": "deny",
    "unicorn/no-magic-array-flat-depth": "deny",
    "unicorn/no-negation-in-equality-check": "deny",
    "unicorn/no-new-array": "allow",
    "unicorn/no-new-buffer": "deny",
    "unicorn/no-single-promise-in-promise-methods": "deny",
    "unicorn/no-thenable": "deny",
    "unicorn/no-unnecessary-array-flat-depth": "deny",
    "unicorn/no-unnecessary-array-splice-count": "deny",
    "unicorn/no-unnecessary-await": "deny",
    "unicorn/no-unnecessary-slice-end": "deny",
    "unicorn/no-unreadable-array-destructuring": "deny",
    "unicorn/no-unreadable-iife": "deny",
    "unicorn/no-useless-collection-argument": "deny",
    "unicorn/no-useless-error-capture-stack-trace": "deny",
    "unicorn/no-useless-fallback-in-spread": "deny",
    "unicorn/no-useless-iterator-to-array": "deny",
    "unicorn/no-useless-length-check": "deny",
    "unicorn/no-useless-promise-resolve-reject": "deny",
    "unicorn/no-useless-spread": "deny",
    "unicorn/no-zero-fractions": "deny",
    "unicorn/numeric-separators-style": [
      "deny",
      {
        "binary": {
          "groupLength": 4,
          "minimumDigits": 0
        },
        "hexadecimal": {
          "groupLength": 2,
          "minimumDigits": 0
        },
        "number": {
          "groupLength": 3,
          "minimumDigits": 5
        },
        "octal": {
          "groupLength": 4,
          "minimumDigits": 0
        },
        "onlyIfContainsSeparator": true
      }
    ],
    "unicorn/prefer-add-event-listener": "deny",
    "unicorn/prefer-array-find": "deny",
    "unicorn/prefer-array-flat-map": "deny",
    "unicorn/prefer-array-index-of": "deny",
    "unicorn/prefer-array-some": "deny",
    "unicorn/prefer-bigint-literals": "deny",
    "unicorn/prefer-blob-reading-methods": "deny",
    "unicorn/prefer-class-fields": "deny",
    "unicorn/prefer-classlist-toggle": "deny",
    "unicorn/prefer-code-point": "deny",
    "unicorn/prefer-default-parameters": "deny",
    "unicorn/prefer-dom-node-append": "deny",
    "unicorn/prefer-dom-node-dataset": "deny",
    "unicorn/prefer-dom-node-remove": "deny",
    "unicorn/prefer-dom-node-text-content": "deny",
    "unicorn/prefer-event-target": "deny",
    "unicorn/prefer-global-this": "deny",
    "unicorn/prefer-import-meta-properties": "deny",
    "unicorn/prefer-includes": "deny",
    "unicorn/prefer-keyboard-event-key": "deny",
    "unicorn/prefer-logical-operator-over-ternary": "deny",
    "unicorn/prefer-math-min-max": "deny",
    "unicorn/prefer-math-trunc": "deny",
    "unicorn/prefer-modern-dom-apis": "deny",
    "unicorn/prefer-modern-math-apis": "deny",
    "unicorn/prefer-native-coercion-functions": "deny",
    "unicorn/prefer-node-protocol": "deny",
    "unicorn/prefer-object-from-entries": "deny",
    "unicorn/prefer-optional-catch-binding": "deny",
    "unicorn/prefer-reflect-apply": "deny",
    "unicorn/prefer-response-static-json": "deny",
    "unicorn/prefer-set-has": "deny",
    "unicorn/prefer-set-size": "deny",
    "unicorn/prefer-string-raw": "deny",
    "unicorn/prefer-string-replace-all": "deny",
    "unicorn/prefer-string-slice": "deny",
    "unicorn/prefer-string-starts-ends-with": "deny",
    "unicorn/prefer-string-trim-start-end": "deny",
    "unicorn/prefer-top-level-await": "deny",
    "unicorn/prefer-type-error": "deny",
    "unicorn/require-array-join-separator": "deny",
    "unicorn/require-module-attributes": "deny",
    "unicorn/require-module-specifiers": "deny",
    "unicorn/switch-case-braces": ["deny", "always"],
    "unicorn/switch-case-break-position": "deny",
    "unicorn/text-encoding-identifier-case": [
      "deny",
      {
        "withDash": false
      }
    ],
    "vitest/consistent-each-for": "deny",
    "vitest/consistent-test-filename": "deny",
    "vitest/consistent-test-it": [
      "deny",
      {
        "fn": "it",
        "withinDescribe": "it"
      }
    ],
    "vitest/consistent-vitest-vi": "deny",
    "vitest/expect-expect": "allow",
    "vitest/hoisted-apis-on-top": "deny",
    "vitest/max-nested-describe": [
      "allow",
      {
        "max": 4
      }
    ],
    "vitest/no-alias-methods": "deny",
    "vitest/no-conditional-expect": "allow",
    "vitest/no-conditional-tests": "deny",
    "vitest/no-disabled-tests": "allow",
    "vitest/no-duplicate-hooks": "deny",
    "vitest/no-focused-tests": "deny",
    "vitest/no-identical-title": "deny",
    "vitest/no-import-node-test": "deny",
    "vitest/no-mocks-import": "deny",
    "vitest/no-restricted-vi-methods": [
      "deny",
      {
        "mock": "vi.mock() is never cleared (isolate: false) and leaks into other test files on the same worker. Spy on the module namespace instead: vi.spyOn(ns, \"fn\") or vi.spyOn(ns, \"constName\", \"get\").",
        "doMock": "vi.doMock() is never cleared (isolate: false) and leaks into other test files on the same worker. Use vi.spyOn() on the module namespace instead.",
        "hoisted": "vi.hoisted() only exists to feed vi.mock() factories, which are banned. Use vi.spyOn() instead.",
        "resetModules": "vi.resetModules() clears the shared module cache for every later test file on this worker (isolate: false)."
      }
    ],
    "vitest/no-standalone-expect": "deny",
    "vitest/no-test-return-statement": "deny",
    "vitest/padding-around-after-all-blocks": "deny",
    "vitest/prefer-called-exactly-once-with": "deny",
    "vitest/prefer-hooks-in-order": "deny",
    "vitest/prefer-hooks-on-top": "deny",
    "vitest/prefer-mock-promise-shorthand": "deny",
    "vitest/prefer-mock-return-shorthand": "deny",
    "vitest/prefer-snapshot-hint": "allow",
    "vitest/prefer-spy-on": "deny",
    "vitest/prefer-to-be": "deny",
    "vitest/prefer-to-contain": "deny",
    "vitest/prefer-to-have-length": "deny",
    "vitest/require-awaited-expect-poll": "deny",
    "vitest/require-local-test-context-for-concurrent-snapshots": "deny",
    "vitest/require-mock-type-parameters": "deny",
    "vitest/require-to-throw-message": "deny",
    "vitest/valid-describe-callback": "allow",
    "vitest/valid-expect": "allow",
    "vitest/valid-expect-in-promise": "deny",
    "vitest/valid-title": [
      "deny",
      {
        "mustMatch": {
          "it": "^should "
        }
      }
    ],
    "vitest/warn-todo": "allow"
  },
  "settings": {
    "jsdoc": {
      "tagNamePreference": {
        "experimental": "experimental"
      },
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "vitest": {
      "typecheck": false
    },
    "jest": {
      "version": null
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "deny",
    "respectEslintDisableDirectives": false
  },
  "ignorePatterns": ["__exclude"]
}
